# ─────────────────────────────────────────────
# Telegram API credentials
# Get these from: https://my.telegram.org/apps
# ─────────────────────────────────────────────

# Your API ID (integer)
TELEGRAM_API_ID=123456

# Your API Hash (string)
TELEGRAM_API_HASH=your_api_hash_here

# Your phone number (international format, e.g. +1234567890)
TELEGRAM_PHONE=+1234567890

# Optional: 2FA password (leave blank if you don't use one)
TELEGRAM_PASSWORD=

# ─────────────────────────────────────────────
# Scraper Configuration
# ─────────────────────────────────────────────

# Comma-separated list of group usernames or invite links to scrape
# Example: my_group1,https://t.me/my_group2,@my_group3
TARGET_GROUPS=group1,group2

# Output format: csv | json | both
OUTPUT_FORMAT=both

# Output directory (relative or absolute path)
OUTPUT_DIR=./output

# Delay between member fetches in seconds (float). Raise this if you hit rate limits.
REQUEST_DELAY=0.5

# Maximum members to fetch per group (0 = no limit)
MAX_MEMBERS=0

# Session file name (without extension). Stores your login session.
SESSION_NAME=telegram_scraper

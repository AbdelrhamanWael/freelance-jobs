      },
      "settings": {
        "accept_conditions_text": "<p>The access has been restricted and the dataset will be accessible only to the participants of the challenge. If you are a registered user of the challenge, please request access and we will grant the access to the dataset after a review.</p>\n\n<p><strong>Each team needs to send a submit the <a href=\"https://drive.google.com/file/d/1y2sR_ymKpSjCdQemCjGN9YazsFO1fmsN/view?usp=share_link\">Registration Form</a> to Prof Wang (cweiwang@mail.ntust.edu.tw; cwwang1979@gmail.com) and Mr. Hikam Muzakky (m11123801@mail.ntust.edu.tw) before obtaining access to dataset.</strong></p>\n\n<p>&nbsp;</p>\n\n<p>Important Dates:</p>\n\n<ul>\n\t<li>Open for registration: April 1, 2023</li>\n\t<li>Training data release: May 1, 2023</li>\n\t<li>Validation data release: June 1, 2023 (00.00 TWT)</li>\n\t<li>Deadline for validation submission: July 1, 2023 (00.00 TWT)</li>\n\t<li>Testing data release: August 1, 2023 (00.00 TWT)</li>\n\t<li>Deadline for testing submission: August 15, 2023 (00.00 TWT)</li>\n\t<li>Deadline for paper submission in the LNCS Springer format (with 4 pages) : September 15, 2023</li>\n\t<li>Challenge workshop: October 8, 2023</li>\n</ul>",
        "allow_guest_requests": true,
        "allow_user_requests": true,
        "secret_link_expiration": 30
      }
    },

es"},"SPN_SELLER_REINSTATE_NEW":{"keywords":["Afficher la liste des prestataires SPN qui proposent un service de rétablissement de compte vendeur"],"title":"Rétablissement du vendeur"},"SPN_TAXES_NEW":{"keywords":["Afficher la liste des prestataires SPN qui proposent des services fiscaux"],"title":"Taxes"},"SPN_TRAINING_NEW":{"keywords":["Afficher la liste des prestataires SPN qui proposent des services de formation"],"title":"Formation"},"SPX_MYC_DASHBOARD":{"keywords":["Ventes à risque","Référence de conformité","Exigences de conformité","État de conformité","Produits impactés","Gérer la conformité","Gérer votre conformité","Charger le fichier pour conformité"],"title":"Gérer votre conformité"},"STEP_DASHBOARD":{"keywords":["Commentaires des acheteurs","Métriques influençant les performances STEP","Ventes attribuées aux publicités sponsorisées","dépenses Sponsored Spend"],"title":"Tableau de bord STEP"},"SUBSCRIBE_AND_SAVE":{"keywords":["Enregistrer","Souscrire","Prévoyez et Économisez","Prévoyez et Économisez pour les vendeurs","Inscription automatique du programme Économisez en vous abonnant Se désinscrire","Financement des remises de base du programme Prévoyez et Économisez","Critères d\'éligibilité au programme Prévoyez et Économisez","Produits expédiés par le vendeur Économisez en vous abonnant","critères de performances Prévoyez et Économisez","Non-éligibilité du vendeur au programme Prévoyez et Économisez","Options de financement vendeur du programme Prévoyez et Économisez","Remises progressives Économisez en vous abonnant"],"title":"Prévoyez et Économisez"},"SUBSCRIPTION_BOX_REPORTS":{"keywords":["Accéder aux rapports Subscription Box et les télécharger."],"title":"Rapports Subscription Box"},"SUBSCRIPTION_GROUP_MANAGER":{"keywords":["Créez et gérez des groupes d\'abonnement pour vos produits."],"title":"Gérer les groupes d\'abonnements"},"TAX_REPORTS":{"keywords":["Filtrer les rapports fiscaux par État","Exigences relatives au seuil du formulaire 1099-K",
:"பரிசோதனைகளை நிர்வகியுங்கள்"},"EXPLORE_SERVICES":{"keywords":["Amazon செல்லர் உலகளாவிய சேவை வழங்குநர்கள்","Amazon செல்லர் சேவை வழங்குநர் டைரக்டரி","Amazon SPN உள்ளூர் வழங்குநர்களை நம்பியது","சர்வீஸ் புரவைடர் நெட்வொர்க் ஆனது வழங்குநராக மாறியது","சர்வீஸ் புரவைடர் நெட்வொர்க்கை ஆராயும் சர்வீஸ்கள்","சேவை வழங்குநர் நெட்வொர்க் சர்வதேச ஷிப்பிங் FBA","SPN கணக்கு மேலாண்மை கேட்டலாக்கிங் சேவைகள்"],"title":"சர்வீஸ்களை ஆராய்க"},"EXPORT_CENTRAL":{"title":"எக்ஸ்போர்ட் சென்ட்ரல்"},"FBA_ANALYTICS":{"title":"அனாலிடிக்ஸ்"},"FBA_DASHBOARD":{"keywords":["வாடிக்கையாளர் ரிட்டர்ன்ஸ் சராசரி ரிட்டர்ன் விகிதம்","மதிப்பிடப்பட்ட காலம் கடந்துவிட்ட இன்வெண்ட்ரிக்கான கூடுதல் கட்டணம்","FBA டாஷ்போர்டு இன்வெண்ட்ரி மேம்படுத்தல்","FBA என்ரோல்மெண்ட் வாய்ப்புகள் டாஷ்போர்டு","விதிக்கப்பட்ட FBA ஃபீஸ் யுஎஸ் டாஷ்போர்டு","FBA இன்வெண்ட்ரி பெர்ஃபார்மன்ஸ் இன்டெக்ஸ் (IPI)","நிலுவையில் உள்ள ஷிப்மெண்ட் பிரச்சனைகள் 120 நாட்கள்","ஃபுல்ஃபில்மெண்ட் சென்டருக்கான டிரான்ஸிட்டில் செயலில் உள்ள ஷிப்மெண்ட்கள்"],"title":"Fulfillment by Amazon டாஷ்போர்டு"},"FBA_INBOUND_PERFORMANCE_DASHBOARD":{"keywords":["120 நாள் இன்பவுண்ட் டிரெண்டுகள்","Amazon பார்கோடு விடுபட்டுள்ளது","பார்கோடை ஸ்கேன் செய்ய முடியவில்லை","பார்கோடை ஸ்கேன் செய்ய முடியவில்லை","பார்கோடை ஸ்கேனர் மூலம் அணுக முடியாது","நீக்கப்பட்ட மற்றும் கைவிடப்பட்ட ஷிப்மெண்ட்டுகள்","FBA இன்பவுண்ட் ஷிப்மெண்ட் குறைபாடுகள்","FBA ஷிப்மெண்ட் பெர்ஃபார்மன்ஸ் இன்சைட்ஸ்","பாக்ஸில் துல்லியமற்ற ஐட்டம் குவான்டிட்டி","துல்லியமற்ற புராடக்ட் குவான்டிட்டிகள்","இன்பவுண்ட் குறைபாடுத் தெளிவுத்திறன்","இன்பவுண்ட் பெர்ஃபார்மன்ஸ்","இன்பவுண்ட் பெர்ஃபார்மன்ஸ் டாஷ்போர்டு","தவறான லேபிள்","தவறான லேபிள்","தவறான லேபிள் ஷிப்மெண்ட்","லேபிள் விடுபடுகின்றது","லேபிள் பிரச்சனை","ஷிப்மெண்ட்டை லேபிளிடவும்","லேபிளிடல் தேவை","லேபிளிடல் தேவை","உற்பத்தியாளர் பார்கோடு காணவில்லை","பிற லேபிள் சிக்கல்கள்","சிக்கல் விகிதம்","ஷிப்மெண்ட்டுகளில் உள்ள பிரச்சனைகள்","ஷிப்மெண்ட் சிக்கல்களைத் தீர்க்கவும்","பாதுகாப்புச் சிக்கல்கள் - பாக்ஸ் தொடர்பானவை","பாக்ஸுக்கு வெளியே உள்ள ஷிப்மெண்ட் லேபிள் தவிர்த்த ஸ்கேன் செய்யக்கூடிய பார்கோடு","ஷிப்மெண்ட் குறைபாடு தொடர்பான பயிற்சி குறிப்புகள்","ஷிப்மெண்ட் சிக்கல் ","ஷிப்மெண்ட் பெர்ஃபார்மன்ஸ்","ஷிப்மெண்ட் பிளேஸ்மெண்ட் சிக்கல்கள்","ஷிப்மெண்ட் சிக்கல்கள்","ஓவர்சைஸ் ஷிப்பிங் பாக்ஸ்","அதிக எடை கொண்ட ஷிப்பிங் பாக்ஸ்","மூச்சுத்திணறல் எச்சரிக்கை லேபிள் தேவை","பாக்ஸில் எதிர்பாராத பொருட்கள் கண்டுபிடிக்கப்பட்டன","பாக்ஸில் எதிர்பாராத புராடக்ட்","தவறாக லேபிளிடப்பட்ட யூனிட்","யூனிட் தவறாக லேபிளிடப்பட்டது"],"title":"இன்பவுண்ட் பெர்ஃபார்மன்ஸ்"},"FBA_INVENTORY":{"keywords":["காலம் கடந்துவிட்ட இன்வெண்ட்ரிக்கான கூடுதல் கட்டணம்","கிடைக்கும் இன்வெண்ட்ரி","AWD இன்வெண்ட்ரி ஹெல்த் மேலோட்டம்","மதிப்பிடப்பட்ட அதிகப்படியான யூனிட்களின் இன்வெண்ட்ரி","அதிகப்படியான இன்வெண்ட்ரி","Fulfillment by Amazon இன்வெண்ட்ரி","FBA இன்வெண்ட்ரி ஹெல்த் ஸ்டேட்டஸ்","சப்ளை வரலாற்று நாட்கள்","இன்பவுண்ட் குவான்டிட்டி","180 நாட்கள் மற்றும் அதற்கு மேற்பட்ட வயதுடைய இன்வெண்ட்ரி","இன்வெண்ட்ரி ஹெல்த்","இன்வெண்ட்ரி லெவல்","இன்வெண்ட்ரி மேலாண்மை","180 நாட்களுக்கும் மேல் உள்ள இன்வெண்ட்ரி","இன்வெண்ட்ரி திட்டமிடல் பரிந்துரை ஃபில்ட்டர்கள்","நீண்ட கால இன்வெண்ட்ரி","குறைந்த இன்வெண்ட்ரி லெவல் ஃபீ","FBA இன்வெண்ட்ரி நிர்வகிப்பு","இன்வெண்ட்ரியை நிர்வகி","ஓவர்ஸ்டாக் இன்வெண்ட்ரி","பரிந்துரைக்கப்படும் செயல்களை பின்செய்யவும் பின்னை அகற்றவும்","புராடக்ட் விவரங்கள்","அதிகப்படியான இன்வெண்ட்ரியைக் குறைக்கவும்","FBA கூடுதல் கட்டணத்தைக் குறைக்கவும்","பழைய இன்வெண்ட்ரிக்கான கூடுதல் கட்டணத்தைக் குறைக்கவும்","ஒதுக்கப்பட்டுள்ளது","சேல்ஸ் சுருக்கவிவரம்","செல்-த்ரூ இன்வெண்டரி","செல்-த்ரூ","கடந்த 90 நாட்களில் விற்கப்பட்டவை","கூடுதல் கட்டணங்கள்","கூடுதல் கட்டண இன்வெண்ட்ரி","உபரி இன்வெண்ட்ரி","ஃபுல்ஃபில் செய்ய இயலாது"],"title":"Amazon இன்வெண்ட்ரியை நிர்வகித்தல்"},"FBA_OPPORTUNITIES":{"keywords":["120 நாட்கள் இலவச FBA ஸ்டோரேஜ்","FBA என்ரோல்மெண்ட் வாய்ப்புகள் கேட்டலாக்","180 நாட்களுக்கு FBA இலவச லிகுய்டேஷன்ஸ்","FBA புதிய ASIN பரிந்துரைகள்","FBA புதிய தேர்ந்தெடுப்பு புரோகிராம் என்ரோல்மெண்ட்","FBA புதிய தேர்ந்தெடுப்பு புரோகிராம் தள்ளுபடி 10%","குறைந்த விலை Fulfillment by Amazon $10 தொடக்க வரம்பு","குறைந்த விலை Fulfillment by Amazon விகிதங்களுக்கான தகுதி"],"title":"வாய்ப்புகள்"},"FBA_RETURNS":{"keywords":["ASIN ரிட்டர்ன் விகித கால்குலேட்டர்","கஸ்டமர் புகாரளித்த ரிட்டர்ன் காரணங்கள்","கஸ்டமர் புகாரளித்த ரிட்டர்ன் செய்வதற்கான காரணங்கள்","FBA ரிட்டர்ன் ரேட் இன்சைட்ஸ்","FBA ரிட்டர்ன்கள்","FBA ரிட்டர்ன்கள் பிராசஸிங் ஃபீ","Fulfillment by Amazon செட்டிங்குகள்","அதிக ரிட்டர்ன் ரேட் புராடக்ட்களின் தொடக்க வரம்பு","பாதிக்கப்பட்ட ASINகள்","ரிட்டர்ன் ஆர்டர்களை நிர்வகிக்கவும்","செல்லரால் ஃபுல்ஃபில் செய்யப்பட்ட ரிட்டர்ன்களை நிர்வகியுங்கள்","மாதாந்திர ரிட்டர்ன் ரேட் சதவீதம்","ரிட்டர்ன் விகிதங்கள்","ரிட்டர்ன் ரிப்போர்ட்","ரிட்டன்ஸ் பெர்ஃபார்மன்ஸ் டாஷ்போர்டு","ரிட்டர்ன்கள் பாலிசி","ரிட்டர்ன்கள் பிராசஸிங் ஃபீ","ஆடைகள் மற்றும் ஷூக்களுக்கான ரிட்டர்ன்கள் பிராசஸிங் ஃபீ"],"title":"FBA ரிட்டர்ன்கள்"},"FBA_SEND_TO_AMAZON":{"keywords":["Amazon உகந்த திட்டம் FNSKU","ஷிப்மெண்ட்டைக் கேன்சல் செய்யவும்","ஒரு ஷிப்மெண்ட்டை மாற்றவும் அல்லது கேன்சல் செய்யவும்","ஷிப்பிங் தேதியை மாற்றவும்","அனுப்ப வேண்டிய இன்வெண்ட்ரியைத் தேர்வுசெய்க","கேரியர் மற்றும் பேலட் தகவலை உறுதிப்படுத்தவும்","ஷிப்பிங்கை உறுதிப்படுத்துதல்","ஏற்கனவே உள்ள இன்வெண்ட்ரிகளை FBAக்கு மாற்றவும்","FBA SKU தேர்வு முறை","மார்க்கெட்பிளேஸ் இலக்கிட தேர்வு FBA","தனித்தனி யூனிட்டுகளைப் பேக் செய்தல்","பேக்கிங் விவரங்கள்","பாக்ஸ் லேபிள்களைப் பிரிண்ட் செய்க","பேலட் லேபிள்களைப் பிரிண்ட் செய்க","Amazon க்கு அனுப்பவும்","Amazonக்கு அனுப்புதல் பணிப்பாய்வு உருவாக்க படிகள்","Amazonக்கு அனுப்புதல் பணிப்பாய்வை மறுபெயரிடவும்","ஷிப்பிங் அனுப்புநர் முகவரி FBA பணிப்பாய்வு","பேக்கிங் தவிர்த்துவிட்டு Amazonக்கு அனுப்புவதைத் தொடர்க"],"title":"Amazon க்கு அனுப்பவும்"},"FBA_SETTINGS":{"keywords":["2D பார்கோடுகள் பாக்ஸ் உள்ளடக்கத் தகவல்","Amazon பார்ட்னராக இருக்கும் LTL கேரியர்","FBA ஆட்டோமேட் செய்யப்பட்ட ஃபுல்ஃபில் செய்ய இயலாத செட்டிங்குகள்","அமெரிக்காவில் FBA நன்கொடைத் புரோகிராம்","FBA காலம் கடந்த இன்வெண்ட்ரிக்கான ஆட்டோமேட் செய்யப்பட்ட ரிமூவல்கள்","FBA ரிட்டர்ன்கள் மதிப்பீடு உரிமை","இன்பவுண்ட் பிளேஸ்மெண்ட் சர்வீஸ் API","MCF பேக்கிங் ஸ்லிப் மெர்ச்சண்ட் பெயர்","ரிட்டர்ன் இல்லாத தீர்மானங்கள் FBA"],"title":"Fulfillment
:["அனைத்து ஆர்டர்கள்","Amazon FBA ரிட்டர்ன்ஸ்","Amazon ஃபுல்ஃபில் செய்த இன்வெண்ட்ரி","Amazon ஃபுல்ஃபில் செய்த ஷிப்மெண்ட்டுகள்","Amazon ஃபுல்ஃபில்மெண்ட் ரிபோர்ட்டுகள்","Amazon ஃபுல்ஃபில்மெண்ட் ரிட்டர்ன் ரிப்போர்ட்","ஃபுல்ஃபில்மெண்ட் சென்டர் மூலம் Amazon ரிட்டர்ன் எண்ணிக்கை","Amazon செல்லர் மையத்தின் FBA ரிட்டர்ன்ஸ்","Amazon செல்லர் ரிட்டர்ன் அறிக்கை","தனிப்பயன் ரிப்போர்ட் பில்டர்","வாடிக்கையாளர் மாற்றுப்பொருள் ஆர்டர்கள் ரிப்போர்ட்","கஸ்டமர் ரிட்டர்ன் காரண ரிப்போர்ட்","FBA கஸ்டமர் ரிட்டர்ன் ரிப்போர்ட்","FBA கஸ்டமர் ரிட்டர்ன்கள்","FBA கஸ்டமர் ரிட்டர்ன்கள் ரிப்போர்ட்","FBA இன்பவுண்ட் பிளேஸ்மெண்ட் சர்வீஸ் ஃபீஸ்","FBA ரீபிளேஸ்மெண்ட்டுகள் ரிப்போர்ட்","FBA ரிட்டர்ன்கள் மேலாண்மை","ஃபீ முன்னோட்டம்","FNSKU ரிட்டர்ன் அகற்றல்","ஃபுல்ஃபில்மெண்ட் சென்டர் ரிட்டர்ன்கள் நிலை","குளோபல் ஸ்டோர் சேல்ஸ் ரிப்போர்ட்","இன்வெண்ட்ரி பாதிப்பு மற்றும் ரீஇம்பர்ஸ்மண்ட் போர்ட்டல் ரிட்டர்ன்ஸ்","இன்வெண்ட்ரி லெட்ஜர்","இன்வெண்ட்ரி ஸ்டோரேஜ் ஓவரேஜ் ஃபீஸ்","மெர்ச்சண்ட் SKU மாற்று வரலாறு","மெர்ச்சண்ட் SKU ரிட்டர்ன்ஸ் டிராக்கிங்","மாதாந்திர ஸ்டோரேஜ் ஃபீஸ்","அசல் கஸ்டமர் ஆர்டர் ID மாற்றுகள்","ரீயிம்பர்ஸ்மெண்ட்டுகள்","மாற்று எண்ணிக்கை ரிப்போர்ட் FBA","மாற்றுப்பொருளுக்கான காரணக் குறியீடுகள் ஃபுல்ஃபில்மெண்ட்","ரீபிளேஸ்மெண்ட்டுகள்","வேர்ஹவுஸ் மாற்று டிராக்கிங்"],"title":"Amazon ஃபுல்ஃபில்மெண்ட் ரிபோர்ட்டுகள்"},"REPORT_CENTRAL_VAT_TRANSACTIONS":{"keywords":["வரி அறிக்கை","VAT"],"title":"Amazon VAT பரிவர்த்தனைகள் அறிக்கை"},"REPORT_CENTRAL_WELCOME_PAGE":{"keywords":["அனைத்து ஆர்டர்கள்","Amazon ஃபுல்ஃபில் செய்த இன்வெண்ட்ரி","Amazon ஃபுல்ஃபில் செய்த ஷிப்மெண்ட்டுகள்","தனிப்பயன் ரிப்போர்ட் பில்டர்","FBA கஸ்டமர் ரிட்டர்ன்கள்","FBA இன்பவுண்ட் பிளேஸ்மெண்ட் சர்வீஸ் ஃபீஸ்","ஃபீ முன்னோட்டம்","குளோபல் ஸ்டோர் சேல்ஸ் ரிப்போர்ட்","இன்வெண்ட்ரி லெட்ஜர்","இன்வெண்ட்ரி ஸ்டோரேஜ் ஓவரேஜ் ஃபீஸ்","மாதாந்திர ஸ்டோரேஜ் ஃபீஸ்","ரீயிம்பர்ஸ்மெண்ட்டுகள்","ரீபிளேஸ்மெண்ட்டுகள்"],"title":"Amazon ஃபுல்ஃபில்மெண்ட் ரிபோர்ட்டுகள்"},"RESTOCK_INVENTORY_RECOMMENDATIONS":{"keywords":["AWD இன்வெண்ட்ரி மேலாண்மை","கெபாசிட்டி மானிட்டர்","மீண்டும் நிரப்புதலுக்க
er only shows a small selection of accounts, while the full page account switcher shows all the customer\'s accessible accounts."},"dropdownAccountSwitcher_title_switchAccount":{"value":"Switch Accounts","note":"The title in the dropdown account switcher."},"fullPageAccountSwitcher_title_selectAccount":{"value":"Select an account","note":"Title shown on the full page account switcher."},"fullPageAccountSwitcher_title_selectBusinessUnit":{"value":"Select a Default Business Unit","note":"Title shown on the full page account switcher for business units. A business unit is any subset of a partner account including enrollment entity types such as merchant-marketplaces and vendor groups."},"fullPageAccountSwitcher_selectAvailableAccount_or_changeAccountLater":{"value":"Switch between your available accounts. You can change this selection at any time through the header.","note":"Text shown on the full page account switcher that instructs users how to change their account now or later."},"fullPageAccountSwitcher_description_withManageAccountsLink":{"value":"Switch between your available accounts. You can change this selection at any time through the header. If you\'d like to consolidate or rename accounts, work with your account administrator to make changes through {manageAccountsLink}.","note":"The description on the full page account switcher page. It links to the Manage Accounts page which allows the user (or the account administrator) to rename or merge the accounts."},"fullPageAccountSwitcher_businessUnitDescription_withManageAccountsLink":{"value":"Some pages can only show one business unit at a time. Pick the one you work with most. We\'ll try to use it automatically when we need to narrow your view. If you\'d like to consolidate or rename accounts, work with your account administrator to make changes through {manageAccountsLink}.","note":"The description on the full page account switcher page for business units. It links to the Manage Accounts page which allows the user (or the account administrator) to rename or merge the accounts. A business unit is any subset of a partner account including enrollment entity types such as merchant-marketplaces and vendor groups."},"fullPageAccountSwitcher_katalAlert_filteredRights_header":{"value":"This list is filtered based on the page you are trying to access.","note":"Katal alert header for notifying user that the accounts displayed to them are filtered by rights"},"fullPageAccountSwitcher_katalAlert_filteredRights_body":{"value":"We\'ve filtered this list of your available accounts based on the page you are trying to access. You can pick a different page or account at any time using the header.","note":"Katal alert body for notifying user that the accounts displayed to them are filtered by rights"},"fullPageAccountSwitcher_EE_selectDifferentAccount":{"value":"Select a different account","note":"Button for returning user to global account full page account switcher"},"fullPageAccountSwitcher_EE_title_selectEEType":{"value":"Select {enrollmentEntityType}","note":"The word select to be used for selecting an account and a variable for the enrollment type (ex: Select Example Enrollment Entity)."},"fullPageAccountSwitcher_EE_body":{"value":"Some pages require you to select a specific business view before you can view them. Please make a selection from the list below.","note":"Text for the Enrollment Entity selection mode of the fullPageAccountSwitcher"},"fullPageAccountSwitcher_businessUnit_countryLabel":{"value":"({countryLabel})","note":"A wrapper around the country label of a business unit in order to offset it from the business unit\'s name. A business unit is any subset of a partner account including enrollment entity types such as merchant-marketplaces and vendor groups."},"fullPageAccountSwitcher_button_loadMoreAccounts":{"value":"Load more accounts","note":"Text for the button in the column of accounts that allows the user to load more accounts."},"fullPageAccountSwitcher_button_selectAccount":{"value":"Select account","note":"Text for the button that confirms the user\'s selected account and redirects them back to the site."},"fullPageAccountSwitcher_button_selectBusinessUnit":{"value":"Make default","note":"Text for the button that confirms the user\'s default business unit and redirects them back to the site. A business unit is any subset of a partner account including enrollment entity types such as merchant-marketplaces and vendor groups."},"fullPageAccountSwitcher_emptyList":{"value":"There\'s nothing to show here.","note":"The text displayed when a list of items is empty."},"fullPageAccountSwitcher_errorMessage":{"value":"Your accounts didn\'t load. Please try again.","note":"Error message displayed to users who encounter an error while loading their account data in the account switcher."},"fullPageAccountSwitcher_loadingAccounts":{"value":"Loading accounts...","note":"The text displayed when the accounts in the account switcher are being loaded."},"fullPageAccountSwitcher_current":{"value":"current","note":"The word current used to indicate the currently selected account."},"fullPageAccountSwitcher_notAuthorizedGeneric":{"value":"You are not currently authorized to access any accounts.","note":"The text displayed when a user is not authorized to any accounts."},"fullPageAccountSwitcher_accessDenied_message":{"value":"You can\'t access this page based on your current selection. You may have access to this page through another account.","note":"Error message displayed on fullPageAccountSwitcher EE page when no accessible enrollment entities are found"},"fullPageAccountSwitcher_button_returnToSignIn":{"value":"Return to sign in","note":"The button text used for logging the user out when"},"fullPageAccountSwitcher_sort_dropdownOption_alphabeticalAZ":{"value":"Alphabetical (A-Z)","note":"The dropdown option used for sorting the list of accounts alphabetically from A to Z"},"fullPageAccountSwitcher_sort_dropdownOption_alphabeticalZA":{"value":"Alphabetical (Z-A)","note":"The dropdown option used for sorting the list of accounts alphabetically from Z to A"},"fullpageAccountSwitcher_search_placeholderMessage_v2":{"value":"Search","note":"Placeholder text that will appear in the search bar when there is no search value entered"},"fullpageAccountSwitcher_search_noSearchResultsHeader":{"value":"No results found for {searchQuery}","note":"Header text that will be displayed when there are no results returned for a search. searchQuery is the value that was searched on"},"fullpageAccountSwitcher_search_noSearchResultsBody":{"value":"Try checking your spelling and make sure you\'re logged in with the correct email address and password combination.","note":"Body message that will be displayed when there are no resulted returned for a search."},"fullPageAccountSwitcher_link_takeTheTour":{"value":"Take the tour","note":"A link on the full page account switcher that opens an instructional user tour."},"vendorTour_step_label":{"value":"Step {stepNumber} of {totalSteps}","note":"Text used for a step by step view, such as a guided user tour. {stepNumber} represents the current step the user on, and {totalSteps} represents the total number of steps in the tour."},"vendorTour_step_1_title":{"value":"See more of your business at once","note":"Title of a user tour step explaining changes to account navigation"},"vendorTour_step_1_body":{"value":"We\'ve consolidated your accounts to make it easier to view and manage your business relationship with Amazon. When you log in, you\'ll now see a simplified account selection that brings related parts of your business together.","note":"Message explaining changes to account navigation"},"vendorTour_step_1_body_v2":{"value":"We\'ve consolidated your accounts to make it easier to view and manage your business with Amazon. Your previous accounts are still available as {businessUnits} within your new account. This will provide a more comprehensive view of your business when using new features such as Custom Analytics.","note":"The first step of the Vendor Central user tour. It explains that the new account switcher displays their vendor groups as business units grouped within a partner account. The \'businessUnits\' parameter (literal: \'business units\') is separated so that the term can be highlighted."},"vendorTour_step_1_body_v2_businessUnits":{"value":"business units","note":"Part of the vendorTour_step_1_body_v2 translation string. It is separated to this term can be highlighted."},"vendorTour_step_2_title":{"value":"Navigating your accounts","note":"Title of a user tour step explaining changes to account navigation"},"vendorTour_step_2_body":{"value":"Not all features use this new view. When using newer features, look for this icon [{icon}] to know which parts of your account you\'re currently seeing. You can switch accounts using the header at any time.","note":"Explains the account view indicator and account switching functionality"},"vendorTour_step_2_body_v2":{"value":"Some features still only show one business unit. If you move to a page that can\'t show everything, we\'ll let you know. Look for the blue dot on the business unit selector in the header. It means your view has narrowed.","note":"The second step of the Vendor Central user tour. It explains that pages on Vendor Central may display only a single business unit (i.e. vendor group) rather than the whole partner account. The business unit account switcher in the header of the page changes depending on whether a page is displaying information about a single business unit, multiple business units, or the whole partner account."},"vendorTour_step_3_title":{"value":"Need to make more changes?","note":"Title of a user tour step explaining changes to account modifications"},"vendorTour_step_3_body":{"value":"If you\'d like to further consolidate your accounts or rename them, visit {manageAccountsLink} or contact Support. This will make sure that you\'re able to get the most out of features that have been updated to use this new consolidated view.","note":"Message explaining changes to account modifications"},"label_manage_accounts":{"value":"Manage Accounts","note":"Title of the manage accounts page"},"common_button_back":{"value":"Back","note":"Text for the back button in a user tour"},"common_button_close":{"value":"Close","note":"Labels the button that closes a popup window."},"common_button_next":{"value":"Next","note":"A button which advances a sequences of steps to the next step"},"common_button_finish":{"value":"Finish","note":"A button to confirm the last step of a sequence of steps"}}}');var Tp=n(6157),Pp=n.n(Tp),Mp=/^[a-z]{2}-[A-Z]{2}$/;function Ip(){var e=document.documentElement.lang;return Mp.test(e)?e:"en-US"}const Rp=function(){var e=Ip(),t=Op({locale:e,fallbackLocale:"en-US",messages:{"en-US":Pp()(Lp.E)},missing:function(e,t){var n=Gs().newChildActionPublisherForMethod("VueI18n");n.publishCounterMonitor("invalidTranslationKey",1),n.publishCounterMonitor("invalidTranslationKey-".concat(t),1)}});return"en-US"!==e&&function(e,t){window.accountSwitcherAssetsTranslations&&window.accountSwitcherAssetsTranslations[e]?t.global.setLocaleMessage(e,window.accountSwitcherAssetsTranslations[e]):document.addEventListener("accountSwitcherAssetsTranslationsLoaded",(function(n){n.locale===e&&t.global.setLocaleMessage(e,window.accountSwitcherAssetsTranslations[e])}))}(e,t),t},Np={install:function(e){e.config.globalProperties.$locale=Ip()}};function Dp(e){return _s({},e.app.config.globalProperties)}const Fp={install:function(e,t){var n=t.mode,r=t.nature;if(n||(n=bs.Default),r||(r=null),!Object.values(bs).includes(n))throw new Error("Invalid mode provided: ".concat(n,". Must be one of: ").concat(Object.values(bs).join(", ")));if(n===bs.GlobalOnly&&null!=r)throw new Error("Nature must not be specified in globalOnly mode.");if(n!==bs.GlobalOnly&&null==r)throw new Error("Nature must be specified in ".concat(n," mode."));e.config.globalProperties.$mode
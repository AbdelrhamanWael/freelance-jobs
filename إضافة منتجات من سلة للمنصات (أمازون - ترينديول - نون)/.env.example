# =============================================================================
# Amazon Seller Central & Salla Validation Configuration (.env)
# =============================================================================

# Target Marketplace (SA = Saudi Arabia, AE = UAE, US = USA, EG = Egypt)
AMAZON_MARKETPLACE=SA

# Amazon Seller Central Credentials (Optional: can also be entered via prompt)
AMAZON_EMAIL=your_seller_email@example.com
AMAZON_PASSWORD=your_secure_password

# Persistent Chrome Profile Directory (Recommended)
# Keeps your Amazon Seller Central session and 2FA cookies active across runs.
CHROME_PROFILE_DIR=chrome_profile

# Default Salla Excel file path
SALLA_EXCEL_PATH=data/raw/salla_products_export.xlsx

# Request Delay Range (in seconds) to avoid rate limits
REQUEST_DELAY_MIN=2.0
REQUEST_DELAY_MAX=4.5

# Title Similarity Threshold (0.0 to 1.0, default 0.80 = 80%)
TITLE_SIMILARITY_THRESHOLD=0.80

# Price Tolerance (Numeric difference, default 0.05 SAR)
PRICE_TOLERANCE=0.05
